* {
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
    color: #1f1d1a;
}

QMainWindow,
#shell,
#contentStack {
    background: #eee9e3;
}

#loginPage {
    background: #b7aea7;
}

#loginPanel {
    background: #fbfaf7;
    border: 1px solid #d8d0c7;
    border-radius: 20px;
    min-width: 380px;
    max-width: 380px;
}

#loginTitle {
    font-size: 28px;
    font-weight: 700;
    color: #151411;
}

#loginSubtitle,
#pageSubtitle,
#brandSubtitle,
#hintText,
#fieldHint {
    color: #827970;
}

#pageTitle {
    font-size: 28px;
    font-weight: 700;
    color: #171511;
}

#sectionTitle {
    font-size: 16px;
    font-weight: 700;
    color: #171511;
}

#sidebar {
    background: #f6f3ee;
    border-right: 1px solid #d8d0c7;
}

#brandTitle {
    color: #151411;
    font-size: 21px;
    font-weight: 700;
}

#brandSubtitle {
    color: #827970;
}

#metricCard,
#sectionPanel,
#topBar {
    background: #fbfaf7;
    border: 1px solid #ded7ce;
    border-radius: 20px;
}

#metricLabel {
    color: #827970;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0px;
}

#metricValue {
    font-size: 26px;
    font-weight: 700;
    color: #151411;
}

#errorText {
    color: #a63325;
    background: #f8ece7;
    border: 1px solid #d8d0c7;
    border-radius: 14px;
    padding: 8px 12px;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 38px;
    padding: 7px 12px;
    background: #f6f2ec;
    border: 1px solid #d8d0c7;
    border-radius: 14px;
    selection-background-color: #d84b35;
    selection-color: #fffaf4;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #d84b35;
    background: #fbfaf7;
}

QComboBox {
    padding-right: 36px;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 32px;
    border-left: 1px solid #d8d0c7;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    background: transparent;
}

QComboBox::drop-down:hover {
    background: #eee8df;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-down.png);
    width: 10px;
    height: 10px;
}

QSpinBox,
QDoubleSpinBox {
    padding-right: 30px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    height: 15px;
    margin-top: 4px;
    margin-right: 6px;
    border: 0;
    border-radius: 7px;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 20px;
    height: 15px;
    margin-right: 6px;
    margin-bottom: 4px;
    border: 0;
    border-radius: 7px;
    background: transparent;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background: #eee8df;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/icons/chevron-up.png);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/icons/chevron-down.png);
    width: 8px;
    height: 8px;
}

QPushButton {
    min-height: 38px;
    padding: 7px 16px;
    border-radius: 14px;
    background: #e8e2da;
    border: 1px solid #d8d0c7;
    color: #1f1d1a;
    font-weight: 600;
}

QPushButton:hover {
    background: #ebe5dc;
}

QPushButton:pressed {
    background: #ded7ce;
}

#primaryButton {
    color: #fffaf4;
    background: #d84b35;
    border: 1px solid #d84b35;
}

#primaryButton:hover {
    background: #c94430;
}

#primaryButton:pressed {
    background: #a63325;
}

#dangerButton {
    color: #fffaf4;
    background: #a63325;
    border: 1px solid #a63325;
}

#dangerButton:hover {
    background: #c94430;
}

#dangerButton:pressed {
    background: #8f2c1f;
}

#secondaryButton,
#navButton {
    text-align: left;
}

#secondaryButton {
    color: #1f1d1a;
    background: #e8e2da;
    border: 1px solid #d8d0c7;
}

#secondaryButton:hover {
    background: #ebe5dc;
}

#navButton {
    color: #615950;
    background: transparent;
    border: 1px solid transparent;
    padding-left: 16px;
    font-weight: 600;
    border-radius: 14px;
}

#navButton:hover {
    color: #1f1d1a;
    background: #eee8df;
}

#navButton:checked {
    color: #fffaf4;
    background: #171511;
    border: 1px solid #171511;
}

QTableWidget {
    background: #fbfaf7;
    alternate-background-color: #f6f2ec;
    border: 1px solid #ded7ce;
    border-radius: 16px;
    gridline-color: #e2ddd6;
    selection-background-color: #f4d952;
    selection-color: #1f1d1a;
    outline: 0;
}

QTableWidget::item {
    border: 0;
    padding: 8px 10px;
}

QTableWidget::item:selected {
    background: #f4d952;
    color: #1f1d1a;
}

#tableEditButton {
    min-height: 28px;
    padding: 4px 12px;
    border-radius: 10px;
    color: #615950;
    background: transparent;
    border: 1px solid transparent;
}

#tableEditButton:hover {
    color: #fffaf4;
    background: #d84b35;
    border: 1px solid #d84b35;
}

#tableEditButton:pressed {
    color: #fffaf4;
    background: #a63325;
    border: 1px solid #a63325;
}

#chargerEditDialog {
    background: #fbfaf7;
}

#dialogTitle {
    font-size: 20px;
    font-weight: 700;
    color: #171511;
}

#dialogSubtitle {
    color: #827970;
}

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    min-height: 40px;
    padding: 8px 10px;
    background: #f6f3ee;
    border: 0;
    border-bottom: 1px solid #d8d0c7;
    font-weight: 600;
    color: #171511;
}

QHeaderView::section:first {
    border-top-left-radius: 16px;
}

QHeaderView::section:last {
    border-top-right-radius: 16px;
}

QTableCornerButton::section {
    background: #f6f3ee;
    border: 0;
    border-bottom: 1px solid #d8d0c7;
    border-top-left-radius: 16px;
}

QScrollBar:horizontal {
    height: 12px;
    background: #eee9e3;
    border: 0;
}

QScrollBar:vertical {
    width: 12px;
    background: #eee9e3;
    border: 0;
}

QScrollBar::handle:horizontal {
    background: #d7d2cc;
    border-radius: 6px;
    min-width: 36px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #d7d2cc;
    border-radius: 6px;
    min-height: 36px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #c8c2bb;
}

QScrollBar::handle:vertical:hover {
    background: #c8c2bb;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QToolTip {
    color: #fffaf4;
    background: #171511;
    border: 1px solid #171511;
    padding: 6px 8px;
}

QChartView {
    background: transparent;
    border: 0;
}
